use io
use noxydb
use tests.assertions as assertions

let path: string = "tests/close_failure.db"
if io.exists(path) then io.remove(path) end
defer io.remove(path)
let db: noxydb.Database = noxydb.open_database(path)
let stable: map[string, any] = {"stable": true}
assertions.assert_true(noxydb.put(ref db, "stable", stable).success, "stable document should store")

let file: io.File = io.File(db.state.file_fd, db.state.path, "a", true)
io.close(file)
noxydb.close_database(ref db)
assertions.assert_false(noxydb.is_open(ref db), "failed close should leave database closed")
assertions.assert_string(noxydb.database_error(ref db), "failed to close database log", "close error should be exact")
noxydb.close_database(ref db)
assertions.assert_string(noxydb.database_error(ref db), "failed to close database log", "second close should preserve error")
let ignored: map[string, any] = {"ignored": true}
assertions.assert_false(noxydb.put(ref db, "later", ignored).success, "failed database should reject writes")
assertions.assert_false(has_key(db.state.payloads, "later"), "rejected write should not mutate raw state")

print("[PASS] close_failure_test")
