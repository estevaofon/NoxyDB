use sys

func fail(message: string) -> void
    print("[FAIL] " + message)
    sys.exit(1)
end

func assert_true(condition: bool, message: string) -> void
    if !condition then
        fail(message)
    end
end

func assert_false(condition: bool, message: string) -> void
    if condition then
        fail(message)
    end
end

func assert_string(actual: string, expected: string, message: string) -> void
    if actual != expected then
        fail(message + " - expected '" + expected + "', got '" + actual + "'")
    end
end

func assert_int(actual: int, expected: int, message: string) -> void
    if actual != expected then
        fail(message + " - expected " + to_str(expected) + ", got " + to_str(actual))
    end
end

func assert_float(actual: float, expected: float, message: string) -> void
    if actual != expected then
        fail(message + " - expected " + to_str(expected) + ", got " + to_str(actual))
    end
end
