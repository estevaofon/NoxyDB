use io
use noxydb
use tests.assertions as assertions

let path: string = "tests/history.db"
let db: noxydb.Database = noxydb.open_database(path)
let version: noxydb.LookupResult = noxydb.get(db, "version")
assertions.assert_true(version.found, "final put should restore key")
assertions.assert_true(version.value["number"] == 4, "replay should preserve final document")
noxydb.close_database(db)
io.remove(path)
print("[PASS] history_read_test")
