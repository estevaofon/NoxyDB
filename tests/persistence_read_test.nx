use io
use noxydb
use tests.assertions as assertions

let path: string = "tests/persistence.db"
let db: noxydb.Database = noxydb.open_database(path)
assertions.assert_true(noxydb.is_open(ref db), "persistence reader should open")
let result: noxydb.LookupResult = noxydb.get(ref db, "chave\tcom\nção")
assertions.assert_true(result.found, "Unicode key should survive")
let profile: map[string, any] = result.value["profile"]
let records: any[] = result.value["records"]
let first: map[string, any] = records[0]
assertions.assert_true(result.value["name"] == "Estevão", "Unicode value should survive")
assertions.assert_true(result.value["empty"] == "", "empty string should survive")
assertions.assert_true(result.value["age"] == 30, "integer should survive")
assertions.assert_true(result.value["score"] == 9.5, "float should survive")
assertions.assert_true(result.value["active"] == true, "bool should survive")
assertions.assert_true(result.value["nothing"] == null, "null should survive")
assertions.assert_true(profile["city"] == "Cuiabá", "nested object should survive")
assertions.assert_true(first["id"] == 1, "array of objects should survive")
let version: noxydb.LookupResult = noxydb.get(ref db, "version")
assertions.assert_true(version.value["number"] == 2, "latest overwrite should survive")
noxydb.close_database(ref db)
io.remove(path)
print("[PASS] persistence_read_test")
