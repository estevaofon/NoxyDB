use io
use noxydb
use tests.assertions as assertions

let path: string = "tests/deleted.db"
let db: noxydb.Database = noxydb.open_database(path)
assertions.assert_true(noxydb.is_open(db), "deleted reader should open the database")
assertions.assert_false(noxydb.get(db, "author").found, "deleted key should remain absent after restart")
assertions.assert_true(noxydb.get(db, "language").found, "unrelated key should survive deletion replay")
noxydb.close_database(db)
io.remove(path)
print("[PASS] deleted_read_test")
