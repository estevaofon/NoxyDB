use io
use noxydb

let path: string = "tests/deleted.db"
if io.exists(path) then io.remove(path) end
let db: noxydb.Database = noxydb.open_database(path)
let language: map[string, any] = {"name": "Noxy"}
let author: map[string, any] = {"name": "Estevao"}
noxydb.put(ref db, "language", language)
noxydb.put(ref db, "author", author)
noxydb.remove(ref db, "author")
noxydb.close_database(ref db)
print("[PASS] deleted_write_test")
