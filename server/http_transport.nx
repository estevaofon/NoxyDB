use net
use json
use strings
use time
use server.protocol as protocol
use server.database_worker as worker

let MAX_REQUEST_BYTES: int = 1048576
let REQUEST_READ_IDLE_TIMEOUT_MS: int = 1000
let REQUEST_BODY_BYTES_PER_TIMEOUT_MS: int = 32
let READ_POLL_SLICE_MS: int = 10

struct HttpReadResult
    complete: bool
    valid: bool
    method: string
    path: string
    body: bytes
    expected_bytes: int
    error: string
end

struct PollReceiveResult
    ready: bool
    ok: bool
    data: bytes
    count: int
end

func http_result(complete: bool, valid: bool, method: string, path: string, body: bytes, expected_bytes: int, error: string) -> HttpReadResult
    return HttpReadResult(complete, valid, method, path, body, expected_bytes, error)
end

func invalid_request(error: string) -> HttpReadResult
    return http_result(true, false, "", "", b"", 0, error)
end

func invalid_parsed_request(method: string, path: string, body: bytes, expected_bytes: int, error: string) -> HttpReadResult
    return http_result(true, false, method, path, body, expected_bytes, error)
end

func invalid_partial_request(request: HttpReadResult, error: string) -> HttpReadResult
    if request.method == "" && request.path == "" then return invalid_request(error) end
    return invalid_parsed_request(request.method, request.path, request.body, request.expected_bytes, error)
end

func find_header_end(buffer: bytes) -> int
    let index: int = 0
    while index + 3 < length(buffer) do
        if buffer[index] == 13 && buffer[index + 1] == 10 && buffer[index + 2] == 13 && buffer[index + 3] == 10 then
            return index
        end
        index = index + 1
    end
    return -1
end

func decimal_length(value: string) -> bool
    if length(value) == 0 then return false end
    let index: int = 0
    while index < length(value) do
        if !strings.is_digit(strings.char_at(value, index)) then return false end
        index = index + 1
    end
    return true
end

func assemble_request(buffer: bytes) -> HttpReadResult
    if length(buffer) > MAX_REQUEST_BYTES then return invalid_request("request too large") end

    let header_end: int = find_header_end(buffer)
    if header_end == -1 then
        if length(buffer) == MAX_REQUEST_BYTES then return invalid_request("incomplete request") end
        return http_result(false, true, "", "", b"", 0, "")
    end

    let header_text: string = to_str(slice(buffer, 0, header_end))
    let lines: strings.SplitResult = strings.split(header_text, "\r\n")
    if lines.count == 0 then return invalid_request("invalid request line") end

    let request_parts: strings.SplitResult = strings.split(lines.parts[0], " ")
    if request_parts.count != 3 then return invalid_request("invalid request line") end
    let method: string = request_parts.parts[0]
    let path: string = request_parts.parts[1]

    let content_length_count: int = 0
    let content_length: int = 0
    let line_index: int = 1
    while line_index < lines.count do
        let line: string = lines.parts[line_index]
        let colon: int = strings.index_of(line, ":")
        if colon <= 0 then return invalid_parsed_request(method, path, b"", 0, "invalid header") end
        let name: string = strings.to_lower(strings.trim(strings.substring(line, 0, colon)))
        if name == "content-length" then
            content_length_count = content_length_count + 1
            if content_length_count > 1 then return invalid_parsed_request(method, path, b"", 0, "duplicate Content-Length") end
            let value: string = strings.trim(strings.substring(line, colon + 1, length(line)))
            if !decimal_length(value) then return invalid_parsed_request(method, path, b"", 0, "invalid Content-Length") end
            let first_significant: int = 0
            while first_significant < length(value) && strings.char_at(value, first_significant) == "0" do
                first_significant = first_significant + 1
            end
            let normalized: string = "0"
            if first_significant < length(value) then normalized = strings.substring(value, first_significant, length(value)) end
            if length(normalized) > 7 then return invalid_parsed_request(method, path, b"", 0, "request too large") end
            content_length = to_int(normalized)
            if content_length > MAX_REQUEST_BYTES then return invalid_parsed_request(method, path, b"", 0, "request too large") end
        end
        line_index = line_index + 1
    end

    let body_start: int = header_end + 4
    let expected_bytes: int = body_start + content_length
    if expected_bytes > MAX_REQUEST_BYTES then return invalid_parsed_request(method, path, b"", expected_bytes, "request too large") end
    if length(buffer) < expected_bytes then
        return http_result(false, true, method, path, b"", expected_bytes, "")
    end
    if length(buffer) > expected_bytes then
        let declared_body: bytes = b""
        if content_length > 0 then declared_body = slice(buffer, body_start, expected_bytes) end
        return invalid_parsed_request(method, path, declared_body, expected_bytes, "surplus request body")
    end

    let body: bytes = b""
    if content_length > 0 then body = slice(buffer, body_start, expected_bytes) end
    return http_result(true, true, method, path, body, expected_bytes, "")
end

func operation_for(method: string, path: string) -> string
    if method == "POST" && path == "/v1/open" then return "open" end
    if method == "POST" && path == "/v1/put" then return "put" end
    if method == "POST" && path == "/v1/get" then return "get" end
    if method == "POST" && path == "/v1/exists" then return "exists" end
    if method == "POST" && path == "/v1/remove" then return "remove" end
    if method == "POST" && path == "/v1/close" then return "close" end
    return ""
end

func quoted_log_value(value: string) -> string
    let encoded: json.EncodeResult = json.dumps_result(value)
    if encoded.success then return encoded.data end
    return "\"<invalid>\""
end

func escaped_log_field(value: string) -> string
    let encoded: json.EncodeResult = json.dumps_result(value)
    if !encoded.success || length(encoded.data) < 2 then return "<invalid>" end
    return strings.substring(encoded.data, 1, length(encoded.data) - 2)
end

func build_activity_line(request: HttpReadResult, status: int, duration_ms: int, timestamp: string) -> string
    let method: string = request.method
    let path: string = request.path
    if method == "" then method = "UNKNOWN" end
    if path == "" then path = "-" end

    let line: string = timestamp + " " + escaped_log_field(method) + " " + escaped_log_field(path)
    let operation: string = operation_for(request.method, request.path)
    if operation != "" then
        let decoded: protocol.ApiRequest = protocol.decode_api_request(operation, request.body)
        if decoded.valid then
            line = line + " database=" + decoded.database
            if operation == "put" || operation == "get" || operation == "exists" || operation == "remove" then
                line = line + " key=" + quoted_log_value(decoded.key)
            end
        end
    end

    let elapsed_ms: int = duration_ms
    if elapsed_ms < 0 then elapsed_ms = 0 end
    return line + " status=" + to_str(status) + " duration_ms=" + to_str(elapsed_ms)
end

func route_request(request: HttpReadResult, commands: chan any) -> protocol.ApiResponse
    if request.method == "GET" && request.path == "/v1/health" then
        return protocol.api_success({"success": true, "status": "ok"})
    end
    let operation: string = operation_for(request.method, request.path)
    if operation == "" then
        if request.path == "/v1/health" || request.path == "/v1/open" || request.path == "/v1/put" || request.path == "/v1/get" || request.path == "/v1/exists" || request.path == "/v1/remove" || request.path == "/v1/close" then
            return protocol.api_error(405, "method not allowed")
        end
        return protocol.api_error(404, "not found")
    end
    let decoded: protocol.ApiRequest = protocol.decode_api_request(operation, request.body)
    if !decoded.valid then return protocol.api_error(400, decoded.error) end
    let reply: any = make_chan(0)
    let command: worker.DatabaseCommand = worker.DatabaseCommand(decoded.operation, decoded.database, decoded.key, decoded.value, reply)
    chan_send(commands, command)
    let response: protocol.ApiResponse = chan_recv(reply)
    chan_close(reply)
    return response
end

func reason_phrase(status: int) -> string
    if status == 200 then return "OK" end
    if status == 400 then return "Bad Request" end
    if status == 404 then return "Not Found" end
    if status == 405 then return "Method Not Allowed" end
    if status == 409 then return "Conflict" end
    if status == 500 then return "Internal Server Error" end
    return "Internal Server Error"
end

func build_http_response(response: protocol.ApiResponse) -> bytes
    let body: bytes = to_bytes(response.json)
    let headers: string = "HTTP/1.1 " + to_str(response.status) + " " + reason_phrase(response.status) + "\r\nContent-Type: application/json\r\nContent-Length: " + to_str(length(body)) + "\r\nConnection: close\r\n\r\n"
    return to_bytes(headers) + body
end

func next_receive_size(buffered_bytes: int) -> int
    let remaining: int = MAX_REQUEST_BYTES - buffered_bytes
    if remaining <= 0 then return 0 end
    if remaining < 65536 then return remaining end
    return 65536
end

func poll_receive(client: net.Socket, timeout_ms: int, network_io: chan any) -> PollReceiveResult
    chan_recv(network_io)
    let read_sockets: net.Socket[64]
    let empty_write_sockets: net.Socket[64]
    let empty_error_sockets: net.Socket[64]
    read_sockets[0] = client
    let selected: any = net_select(read_sockets, empty_write_sockets, empty_error_sockets, timeout_ms)
    let ok: bool = false
    let data: bytes = b""
    let count: int = 0
    let readable: bool = selected.read_count > 0
    while selected.read_count > 0 && count < 65536 do
        let received: net.NetResult = net.socket_recv(client, 1)
        ok = received.ok
        if !received.ok || received.count == 0 then
            break
        end
        data = data + slice(received.data, 0, received.count)
        count = count + received.count
        selected = net_select(read_sockets, empty_write_sockets, empty_error_sockets, 0)
    end
    chan_send(network_io, true)
    return PollReceiveResult(readable, ok, data, count)
end

func has_immediate_surplus(client: net.Socket, network_io: chan any) -> bool
    let result: PollReceiveResult = poll_receive(client, 0, network_io)
    return result.ready && result.ok && result.count > 0
end

func read_http_request(client: net.Socket, network_io: chan any) -> HttpReadResult
    let buffer: bytes = b""
    let expected_bytes: int = 0
    let partial_request: HttpReadResult = http_result(false, true, "", "", b"", 0, "")
    let started_at: int = time.now_ms()
    let idle_deadline: int = started_at + REQUEST_READ_IDLE_TIMEOUT_MS
    let absolute_deadline: int = started_at + REQUEST_READ_IDLE_TIMEOUT_MS + MAX_REQUEST_BYTES / REQUEST_BODY_BYTES_PER_TIMEOUT_MS
    while true do
        let poll_deadline: int = idle_deadline
        if absolute_deadline < poll_deadline then poll_deadline = absolute_deadline end
        let remaining_ms: int = poll_deadline - time.now_ms()
        if remaining_ms <= 0 then return invalid_partial_request(partial_request, "request read timeout") end
        let poll_timeout_ms: int = remaining_ms
        if poll_timeout_ms > READ_POLL_SLICE_MS then poll_timeout_ms = READ_POLL_SLICE_MS end
        let polled: PollReceiveResult = poll_receive(client, poll_timeout_ms, network_io)
        if polled.ready then
            if !polled.ok then return invalid_partial_request(partial_request, "failed to read request") end
            if polled.count == 0 then return invalid_partial_request(partial_request, "incomplete request") end
            buffer = buffer + slice(polled.data, 0, polled.count)
            idle_deadline = time.now_ms() + REQUEST_READ_IDLE_TIMEOUT_MS

            let request: HttpReadResult = assemble_request(buffer)
            partial_request = request
            if request.complete then
                if request.valid && has_immediate_surplus(client, network_io) then
                    return invalid_parsed_request(request.method, request.path, request.body, request.expected_bytes, "surplus request body")
                end
                return request
            end
            if !request.valid then return request end
            if expected_bytes == 0 && request.expected_bytes > 0 then
                expected_bytes = request.expected_bytes
                let remaining_body_bytes: int = expected_bytes - length(buffer)
                let body_absolute_deadline: int = time.now_ms() + REQUEST_READ_IDLE_TIMEOUT_MS + remaining_body_bytes / REQUEST_BODY_BYTES_PER_TIMEOUT_MS
                if body_absolute_deadline < absolute_deadline then absolute_deadline = body_absolute_deadline end
            end
        end
    end
    return invalid_partial_request(partial_request, "failed to read request")
end

func handle_client(client: net.Socket, commands: chan any, network_io: chan any) -> void
    let started_at: int = time.now_ms()
    let request: HttpReadResult = read_http_request(client, network_io)
    let response: protocol.ApiResponse = protocol.api_error(400, request.error)
    if request.complete && request.valid then response = route_request(request, commands) end
    let response_bytes: bytes = build_http_response(response)
    let sent_bytes: int = 0
    while sent_bytes < length(response_bytes) do
        let sent: net.NetResult = net.socket_send(client, slice(response_bytes, sent_bytes, length(response_bytes)))
        if !sent.ok || sent.count <= 0 then
            break
        end
        sent_bytes = sent_bytes + sent.count
    end
    net.socket_close(client)
    let timestamp: string = time.format_custom(time.now_datetime(), "%Y-%m-%dT%H:%M:%S")
    print(build_activity_line(request, response.status, time.now_ms() - started_at, timestamp))
end

func run_client_handler(client: net.Socket, commands: chan any, network_io: chan any, handler: func) -> void
    handler(client, commands, network_io)
end

func serve_local(port: int, commands: chan any) -> void
    let listener: net.Socket = net.listen("127.0.0.1", port)
    if !listener.open then
        print("failed to listen on 127.0.0.1:" + to_str(port))
        return
    end
    let network_io: chan any = make_chan(1)
    chan_send(network_io, true)
    while true do
        let client: net.Socket = net.accept(listener)
        if client.open then
            spawn(run_client_handler, client, commands, network_io, handle_client)
        end
    end
    chan_close(network_io)
    net.socket_close(listener)
end
